<odoo>
    <template id="running_job_banner">
        <div
            class="alert alert-warning mb-0"
            role="alert"
            t-attf-invisible="not running_job_names"
        >
            <p class="mb-1">
                <i class="fa fa-lg fa-info-circle" />
                Running queue job(s):
                <field name="running_job_names" readonly="1" />
            </p>
        </div>
    </template>
</odoo>
