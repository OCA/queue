<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="queue_job_form_profiler" model="ir.ui.view">
        <field name="name">queue.job.form.profiler</field>
        <field name="model">queue.job</field>
        <field name="inherit_id" ref="queue_job.view_queue_job_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_profile"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-line-chart"
                    invisible="not job_is_profiled"
                >
                    <field
                        name="job_is_profiled"
                        widget="statinfo"
                        string="View profiler"
                    />
                </button>
            </xpath>
        </field>
    </record>
</odoo>
