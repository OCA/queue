<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="privilege_queue_job" model="res.groups.privilege">
        <field name="name">Job Queue</field>
        <field name="sequence" eval="50" />
    </record>
    <record id="module_category_queue_job" model="ir.module.category">
        <field name="name">Job Queue</field>
        <field name="sequence" eval="20" />
    </record>
    <record id="group_queue_job_manager" model="res.groups">
        <field name="name">Job Queue Manager</field>
        <field name="privilege_id" ref="privilege_queue_job" />
        <field
            name="user_ids"
            eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"
        />
    </record>
</odoo>
